# ============================================================
# CloudSync Environment Variables
# Copy this file to .env.local and fill in real values.
# ============================================================

# --- Supabase ---
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Server-only, never expose to client

# --- Yjs WebSocket Collaboration Server ---
# In development: ws://localhost:1234
# In production:  Deploy the y-websocket server (see /collab-server/) and set its URL
NEXT_PUBLIC_YJS_WS_URL=ws://localhost:1234

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
